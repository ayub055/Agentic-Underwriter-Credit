{
  "__artifact__": "address_quality_scorer",
  "format": "logreg_state_dict.v1",
  "model_version": "address-quality-v1.2.0",
  "trained_on": "synthetic-demo-corpus",
  "note": "Demo seam: in production this is a torch checkpoint loaded via torch.load(). For the dependency-free demo the same state dict is serialized as JSON so inference.py runs without PyTorch installed.",
  "features": [
    "kyc_address_match",
    "pincode_serviceable",
    "years_at_address",
    "ownership_owned",
    "address_completeness",
    "geo_risk_index",
    "digital_footprint"
  ],
  "feature_labels": {
    "kyc_address_match": "Address matches KYC records",
    "pincode_serviceable": "PIN code inside serviceable network",
    "years_at_address": "Residential stability (tenure)",
    "ownership_owned": "Self-owned residence",
    "address_completeness": "Complete, well-formed address",
    "geo_risk_index": "Geographic risk zone",
    "digital_footprint": "Verifiable delivery / utility footprint"
  },
  "standardize": {
    "mean": [0.85, 0.90, 4.0, 0.55, 0.80, 0.35, 0.70],
    "std":  [0.36, 0.30, 3.5, 0.50, 0.20, 0.22, 0.46]
  },
  "weights": [0.55, 0.45, 0.28, 0.35, 0.42, -0.65, 0.30],
  "bias": -0.30
}
